{
  "rewrites": [
    { "source": "/boutique/:shopSlug", "destination": "/src/pages/shop.html" },
    { "source": "/boutique/:shopSlug/produit/:productSlug", "destination": "/src/pages/product.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/escrows/release-due",
      "schedule": "5 0 * * *"
    },
    {
      "path": "/api/cron/disputes/process-due",
      "schedule": "10 0 * * *"
    }
  ]
}
