{
  "version": 2,
  "installCommand": "npm run install:all",
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/manifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/src/pages/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://code.iconify.design https://va.vercel-scripts.com https://unpkg.com https://www.googletagmanager.com https://www.google-analytics.com https://cdn.jsdelivr.net https://browser.sentry-cdn.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://unpkg.com https://cdn.jsdelivr.net https://*.supabase.co wss://*.supabase.co https://vitals.vercel-insights.com https://*.ingest.sentry.io https://*.sentry.io https://*.ingest.de.sentry.io https://o4511238099566592.ingest.de.sentry.io https://api.iconify.design https://api.simplesvg.com https://api.unisvg.com https://fonts.googleapis.com https://fonts.gstatic.com https://www.google-analytics.com https://region1.google-analytics.com https://www.googletagmanager.com https://generativelanguage.googleapis.com; media-src 'self' blob: https:; worker-src 'self' blob:; frame-src 'self'; manifest-src 'self';"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "accelerometer=(), camera=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
        }
      ]
    }
  ],
  "functions": {
    "api/[...path].js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/(catalog|login|product|shop|favorites|shops|support|faq|seller-onboarding|vendor-dashboard|customer-dashboard|publish|reset-password|achat|promo|settings|terms|privacy|mentions-legales|system-health|payment-success|payment-cancel|invoice-verify|about|seller|404|500|kinshasa|choose-role|notifications)",
      "destination": "/src/pages/$1.html"
    },
    {
      "source": "/admin",
      "destination": "/src/pages/admin/index.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/src/pages/admin/$1.html"
    },
    {
      "source": "/signup/:code",
      "destination": "/src/pages/login?signup=1&ref=:code"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/app?path=:path*"
    },
    {
      "source": "/facture/:orderId",
      "destination": "/src/pages/invoice-verify?order_id=:orderId"
    },
    {
      "source": "/Boutique/:shopSlug/:productSlug/:rand/NewKet",
      "destination": "/src/pages/product?id=:productSlug"
    },
    {
      "source": "/Boutique/:shopSlug/NewKet",
      "destination": "/src/pages/shop?shop=:shopSlug"
    },
    {
      "source": "/boutique/:shopSlug/NewKet",
      "destination": "/src/pages/shop?shop=:shopSlug"
    },
    {
      "source": "/boutique/:shopSlug",
      "destination": "/src/pages/shop?shop=:shopSlug"
    },
    {
      "source": "/boutique/:shopSlug/produit/:productSlug",
      "destination": "/src/pages/product?id=:productSlug"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/escrows/release-due",
      "schedule": "5 0 * * *"
    },
    {
      "path": "/api/cron/disputes/process-due",
      "schedule": "10 0 * * *"
    },
    {
      "path": "/api/cron/push/process-due",
      "schedule": "15 0 * * *"
    },
    {
      "path": "/api/cron/products/image-watchdog",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/cron/payouts/process-deferred",
      "schedule": "45 0 * * *"
    }
  ]
}