{
  "appId": "cd.newket.app",
  "appName": "NewKet",
  "webDir": "dist",
  "server": {
    "allowNavigation": [
      "*.supabase.co",
      "*.supabase.in"
    ]
  },
  "android": {
    "webContentsDebuggingEnabled": true
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "StatusBar": {
      "style": "DEFAULT",
      "overlaysWebView": true
    },
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#ffffff",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    }
  }
}

