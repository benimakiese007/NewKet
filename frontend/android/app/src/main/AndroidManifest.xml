<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- OAuth callback used by Supabase after Google authentication. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="newket" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Widget 1: Accès Rapide Carré (2x2) -->
        <receiver
            android:name=".NewKetWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/newket_widget_info" />
        </receiver>

        <!-- Widget 2: Barre Horizontale Rapide (4x1 / 4x2 style iOS Medium) -->
        <receiver
            android:name=".NewKetBarWidgetProvider"
            android:exported="true"
            android:label="@string/widget_bar_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/newket_widget_bar_info" />
        </receiver>

        <!-- Widget 3: Produit Sponsorisé Star Plein-Cadre (2x2 style iOS Small) -->
        <receiver
            android:name=".NewKetSmallProductWidgetProvider"
            android:exported="true"
            android:label="@string/widget_small_product_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/newket_widget_small_product_info" />
        </receiver>

        <!-- Widget 4: Vitrine Produits Sponsorisés (4x4 style iOS Large) -->
        <receiver
            android:name=".NewKetLargeWidgetProvider"
            android:exported="true"
            android:label="@string/widget_large_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/newket_widget_large_info" />
        </receiver>

        <!-- Activité d'appel vocal plein écran (Écran verrouillé & Slider natif) -->
        <activity
            android:name=".IncomingCallActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.NoActionBar" />

        <!-- Récepteur d'actions rapides de notification d'appel (Décrocher / Refuser) -->
        <receiver
            android:name=".CallNotificationActionReceiver"
            android:exported="false" />

        <!-- Service FCM NewKet avec prise en charge FullScreenIntent pour appels vocaux -->
        <service
            android:name=".NewKetFirebaseMessagingService"
            android:exported="false">
            <intent-filter android:priority="1000">
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Foreground Service pour appels vocaux entrants en arrière-plan.
             Contourne les restrictions Samsung One UI sur le lancement d'activités. -->
        <service
            android:name=".CallForegroundService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Foreground Service pour appels vocaux (requis Android 9+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Type mediaPlayback : lecture audio (sonnerie d'appel) — Android 14+ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Android 13+ Notification Permission for Live Tracking -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Biometric Authentication (Empreinte digitale / Reconnaissance faciale) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Mise à jour in-app depuis GitHub Releases (Android 8.0+ / API 26+) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Caméra (Capture directe photos de produits & documents KYC) -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Microphone (Messages vocaux dans le flux & appels audio) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Galerie Photos & Médias (Android 13+ et versions antérieures) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <!-- Feature requirements (Optionnels pour ne bloquer aucun appareil sans capteur spécifique) -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
