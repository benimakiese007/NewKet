{
  "name": "newket-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "NewKet - Plateforme e-commerce (Monorepo Fullstack)",
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "build": "npm run build:frontend",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "build:frontend": "cd frontend && npm run build",
    "install:all": "cd frontend && npm install --legacy-peer-deps && cd ../backend && npm install --legacy-peer-deps",
    "test:e2e": "playwright test --config=tests/playwright.config.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benimakiese007/NOVA-V2.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "playwright": "^1.61.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "vitest": "^5.0.1"
  }
}
